{
  "name": "kawanbelanja-media-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion Studio produksi visual PNG & video MP4 otomatis untuk Kawan Belanja",
  "scripts": {
    "studio": "remotion studio",
    "still:square": "remotion still src/index.ts PromoSquare ../workspace/assets/promo-square.png --frame=45",
    "still:comparison": "remotion still src/index.ts ComparisonCard ../workspace/assets/comparison-card.png --frame=45",
    "still:vertical": "remotion still src/index.ts PromoVertical ../workspace/assets/promo-vertical-cover.png --frame=60",
    "render:vertical": "remotion render src/index.ts PromoVertical ../workspace/assets/promo-vertical.mp4",
    "render:square": "remotion render src/index.ts PromoSquare ../workspace/assets/promo-square.mp4",
    "fetch:asset": "node scripts/fetch-assets.mjs"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.280",
    "@remotion/tailwind": "^4.0.280",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.280"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0"
  }
}
